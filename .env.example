# Copy this file to .env.local and fill in the values from Supabase:
# Project Settings -> API Keys (and Data API for the URL).
# On Vercel, add the same two variables under Settings -> Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (sb_publishable_...). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
